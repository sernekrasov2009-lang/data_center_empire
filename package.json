{
  "name": "uptime-empire",
  "productName": "Uptime Empire",
  "version": "0.10.0",
  "description": "Uptime Empire — экономический симулятор админа ЦОД",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "balance-sim": "node tools/balance-sim.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
